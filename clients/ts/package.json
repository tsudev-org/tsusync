{
  "name": "@tsudev/sync",
  "version": "0.1.0",
  "description": "Thư viện máy khách TsuDEV Sync: mã hoá đầu cuối (libsodium secretstream + Argon2id) và gọi API đồng bộ",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "vectors": "node --experimental-strip-types scripts/gen-vectors.ts"
  },
  "packageManager": "npm@11.21.2",
  "dependencies": {
    "libsodium-wrappers-sumo": "0.8.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
