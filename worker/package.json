{
  "name": "@tsudev/tsusync-worker",
  "private": true,
  "version": "0.2.0",
  "description": "TsuDEV Sync: máy chủ đồng bộ bản mã dùng chung (Cloudflare Workers + D1 + R2), mỗi sản phẩm một không gian tên, chỉ cho tài khoản TsuDEV Pro",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "migrate:local": "wrangler d1 migrations apply tsusync --local",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "hono": "4.13.19",
    "jose": "6.2.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.5",
    "@cloudflare/workers-types": "5.20261120.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  },
  "packageManager": "npm@11.21.2",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261118.1": true
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.30.2"
  }
}
