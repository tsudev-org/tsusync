{
  "name": "@tsudev/tsusync-worker",
  "private": true,
  "version": "0.1.0",
  "description": "TsuDEV Sync: máy chủ đồng bộ bản mã dùng chung (Cloudflare Workers + D1 + R2), mỗi sản phẩm một không gian tên, chỉ cho tài khoản TsuDEV Pro",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "migrate:local": "wrangler d1 migrations apply tsusync --local",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "hono": "4.13.19",
    "jose": "6.2.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261117.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0",
    "wrangler": "4.163.0"
  },
  "packageManager": "npm@11.21.2",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261116.1": true
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.30.2",
    "@cloudflare/vitest-pool-workers": {
      "zod": "4.6.7",
      "wrangler": "4.163.0"
    }
  }
}
